{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/v3-workload-manifest.schema.json",
  "title": "V3 Stream Workload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadId",
    "workloadVersion",
    "workloadRole",
    "datasetVersion",
    "driverType",
    "targetEps",
    "duration",
    "eventLimit",
    "userCardinality",
    "userDistribution",
    "heavyUserRatio",
    "targetUserConcentration",
    "targetPartitionDistribution",
    "partitionAffinityStrategy",
    "sourceProfile",
    "eventTimeMode",
    "sourceTimeResolution",
    "timeScaleFactor",
    "latenessProfile",
    "replayRate",
    "statefulWindowProfile",
    "randomSeed"
  ],
  "properties": {
    "workloadId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "workloadVersion": {"type": "string", "pattern": "^v[0-9]+$"},
    "workloadRole": {"enum": ["VOLUME_CORRECTNESS", "NORMAL_CAPACITY", "ORGANIC_BURST", "CATCH_UP_BURST", "USER_SKEW", "PARTITION_SKEW", "STATEFUL_WINDOW_SCALING", "STATEFUL_REDELIVERY", "LATE_OUT_OF_ORDER", "HISTORICAL_REPLAY"]},
    "datasetVersion": {"type": "string", "minLength": 1},
    "driverType": {"enum": ["HTTP_K6", "HTTP_SOURCE_EMULATOR", "KAFKA_DIRECT_PRODUCER"]},
    "targetEps": {"type": "number", "exclusiveMinimum": 0},
    "duration": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
    "eventLimit": {"type": "integer", "minimum": 1},
    "userCardinality": {"type": "integer", "minimum": 1},
    "userDistribution": {"enum": ["UNIFORM", "PAYSIM_MEASURED", "SYNTHETIC_USER_SKEW", "PARTITION_AFFINITY"]},
    "heavyUserRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "targetUserConcentration": {"type": ["object", "null"]},
    "targetPartitionDistribution": {
      "type": ["object", "null"],
      "propertyNames": {"pattern": "^[0-9]+$"},
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "partitionAffinityStrategy": {"type": ["string", "null"]},
    "sourceProfile": {"enum": ["NORMAL", "SLOW_SOURCE", "BATCH_CATCHUP", "HISTORICAL"]},
    "eventTimeMode": {"enum": ["PRESERVE_SOURCE_TIME", "REBASE_TO_ARRIVAL", "CONTROLLED_LATENESS"]},
    "sourceTimeResolution": {"type": "string", "minLength": 1},
    "timeScaleFactor": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "latenessProfile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "allowedLateness",
        "tooLateAge",
        "eventAmount",
        "buckets",
        "expectedTooLateEvents",
        "expectedAcceptedLateEvents"
      ],
      "properties": {
        "allowedLateness": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
        "tooLateAge": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
        "eventAmount": {"type": "number", "minimum": 0},
        "buckets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lateness"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
              "lateness": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"}
            }
          }
        },
        "expectedTooLateEvents": {"type": "integer", "minimum": 0},
        "expectedAcceptedLateEvents": {"type": "integer", "minimum": 0},
        "outOfOrderPattern": {
          "type": ["array", "null"],
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        },
        "note": {"type": "string"}
      }
    },
    "replayRate": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "statefulWindowProfile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "runtimeWindow",
        "expectedEventsPerUserInWindow",
        "expectedMaxEventsPerUserInWindow",
        "eventAmount",
        "expectedAmountSumPerUserInWindow"
      ],
      "properties": {
        "runtimeWindow": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"},
        "expectedEventsPerUserInWindow": {"type": "number", "minimum": 0},
        "expectedMaxEventsPerUserInWindow": {"type": "number", "minimum": 0},
        "eventAmount": {"type": "number", "minimum": 0},
        "expectedAmountSumPerUserInWindow": {"type": "number", "minimum": 0},
        "redeliveryDrillTargetIndex": {"type": "integer", "minimum": 0},
        "redeliveryDrillNextIndex": {"type": "integer", "minimum": 0},
        "expectedNextEventTransactionCount": {"type": "integer", "minimum": 0},
        "expectedNextEventAmountSum": {"type": "number", "minimum": 0},
        "expectedNextEventRiskScore": {"type": "integer", "minimum": 0},
        "expectedNextEventMatchedRule": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "randomSeed": {"type": "integer", "minimum": 0},
    "stages": {
      "type": ["array", "null"],
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "targetEps", "duration"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "targetEps": {"type": "number", "minimum": 0},
          "duration": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$"}
        }
      }
    }
  }
}
