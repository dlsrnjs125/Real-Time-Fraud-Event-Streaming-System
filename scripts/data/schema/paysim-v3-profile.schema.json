{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/paysim-v3-profile.schema.json",
  "title": "PaySim V3 Corpus Profile",
  "type": "object",
  "required": [
    "profileSchemaVersion",
    "profilerVersion",
    "datasetSlug",
    "rawFileName",
    "inputSha256",
    "acceptedRows",
    "rejectedRows",
    "totalEvents",
    "uniqueUsers",
    "eventsPerUser",
    "top1PercentTrafficShare",
    "eventsPerUserPerSourceStep",
    "maximumEventsPerSourceStepPerUser",
    "usersWith2PlusEventsPerSourceStepRatio",
    "usersWith5PlusEventsPerSourceStepRatio",
    "nativeTransactionTypeDistribution",
    "normalizedTransactionTypeDistribution",
    "transactionTypeDistribution",
    "fraudRatio",
    "amount",
    "timeStepDistribution",
    "peakTimeStepCount",
    "sameUserRepeatRate",
    "identifierPolicyVersion",
    "sourceTimeResolution",
    "quantileMethod",
    "topPercentRoundingRule",
    "sourceStepBoundaryRule",
    "generatedAt"
  ],
  "properties": {
    "profileSchemaVersion": {"const": "v3-phase0-profile-v1"},
    "sourceTimeResolution": {"const": "1h"},
    "quantileMethod": {"const": "nearest-rank"},
    "inputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptedRows": {"type": "integer", "minimum": 0},
    "rejectedRows": {"type": "integer", "minimum": 0},
    "totalEvents": {"type": "integer", "minimum": 0},
    "uniqueUsers": {"type": "integer", "minimum": 0},
    "top1PercentTrafficShare": {"type": "number", "minimum": 0, "maximum": 1},
    "usersWith2PlusEventsPerSourceStepRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "usersWith5PlusEventsPerSourceStepRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "fraudRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "sameUserRepeatRate": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
