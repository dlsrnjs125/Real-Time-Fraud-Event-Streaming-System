  "panels": [
    {
      "id": 1,
      "title": "Stream Boundary EPS",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(fraud_stream_intake_receipt_persisted_total{job=\"app-api\"}[1m]))", "legendFormat": "receipt persisted"},
        {"refId": "B", "expr": "sum(rate(fraud_stream_kafka_publish_success_total{job=\"app-api\"}[1m]))", "legendFormat": "publish success"},
        {"refId": "C", "expr": "sum(rate(fraud_stream_kafka_publish_failure_total{job=\"app-api\"}[1m]))", "legendFormat": "publish failure"},
        {"refId": "D", "expr": "sum(rate(fraud_stream_consumer_delivery_total{job=\"app-consumer\"}[1m]))", "legendFormat": "consumer delivery"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 2,
      "title": "Total Consumer Group Lag",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(kafka_consumergroup_lag{job=\"kafka-exporter\", consumergroup=\"fraud-event-consumer\", topic=\"transaction-events\"})", "legendFormat": "total lag"}],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 3,
      "title": "Partition Lag",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (partition) (kafka_consumergroup_lag{job=\"kafka-exporter\", consumergroup=\"fraud-event-consumer\", topic=\"transaction-events\"})", "legendFormat": "partition {{partition}}"}],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "Lag Growth and Drain Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "clamp_min(deriv((sum(kafka_consumergroup_lag{job=\"kafka-exporter\", consumergroup=\"fraud-event-consumer\", topic=\"transaction-events\"}))[1m:15s]), 0)", "legendFormat": "growth records/s"},
        {"refId": "B", "expr": "clamp_min(-deriv((sum(kafka_consumergroup_lag{job=\"kafka-exporter\", consumergroup=\"fraud-event-consumer\", topic=\"transaction-events\"}))[1m:15s]), 0)", "legendFormat": "drain records/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "title": "Kafka Producer to Consumer Delay",
